<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>Ornare.Cli</RootNamespace>
    <AssemblyName>Ornare.Cli</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);IL2050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ornare.Core\Ornare.Core.csproj" />
    <ProjectReference Include="..\Ornare.Imaging\Ornare.Imaging.csproj" />
    <ProjectReference Include="..\Ornare.Storage\Ornare.Storage.csproj" />
    <ProjectReference Include="..\Ornare.Windows\Ornare.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
