<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>Ornare.App</RootNamespace>
    <AssemblyName>Ornare.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <NoWarn>$(NoWarn);IL2050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="..\..\assets\emblems\manifest.json" Link="assets\emblems\manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ornare.Core\Ornare.Core.csproj" />
    <ProjectReference Include="..\Ornare.DesignSystem\Ornare.DesignSystem.csproj" />
    <ProjectReference Include="..\Ornare.Imaging\Ornare.Imaging.csproj" />
    <ProjectReference Include="..\Ornare.Storage\Ornare.Storage.csproj" />
    <ProjectReference Include="..\Ornare.Windows\Ornare.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" />
    <PackageReference Include="WinUIEx" />
  </ItemGroup>


</Project>
