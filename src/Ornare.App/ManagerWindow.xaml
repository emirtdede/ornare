<Window
    x:Class="Ornare.App.ManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Ornare.App"
    mc:Ignorable="d">

    <Grid x:Name="ZoomViewport" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="ZoomSurface" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContentPanel.MaxWidth" Value="800" />
                        <Setter Target="MainContentGrid.Padding" Value="36,12,36,32" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NormalLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContentPanel.MaxWidth" Value="720" />
                        <Setter Target="MainContentGrid.Padding" Value="28,8,28,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContentPanel.MaxWidth" Value="560" />
                        <Setter Target="MainContentGrid.Padding" Value="16,8,16,16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <!-- 1. Dedicated Full-Width Title Bar & Drag Area (48px) -->
            <RowDefinition Height="48" />
            <!-- 2. Main Work Area (Sidebar + Content) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Window Title Bar & Native Drag Region (Spans entire top edge: Sidebar + Content) -->
        <Grid x:Name="AppTitleBarDragArea" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <!-- Brand above sidebar (225px) -->
                <ColumnDefinition Width="225" />
                <!-- Draggable Title & Content Header space -->
                <ColumnDefinition Width="*" />
                <!-- Reserved space for native caption buttons (Minimize, Maximize, Close) -->
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <!-- Brand / App Identity (Top of Sidebar) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="20,0,16,0">
                <Image Source="Assets/OrnareLogo.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Text="Ornare" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="AppSubtitleText" Text="Folder Icons" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,1,0,0" />
            </StackPanel>

            <!-- Draggable Area across center -->
            <Grid Grid.Column="1" Background="Transparent" />

            <!-- Column 2 (Width 140) reserved for Windows caption buttons -->
        </Grid>

        <!-- Main Workspace (Row 1) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Navigation Sidebar: 225px for comfortable label breathing room -->
                <ColumnDefinition Width="225" />
                <!-- Main Content Canvas -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="16,8,16,20">
                <!-- Navigation Menu -->
                <ListView
                    x:Name="NavListView"
                    SelectionMode="Single"
                    SelectionChanged="OnNavSelectionChanged">
                    <ListViewItem x:Name="NavItemLibrary" AutomationProperties.Name="Library" Tag="Library" Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                            <TextBlock x:Name="NavTextLibrary" Text="Library" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemRecent" AutomationProperties.Name="Recent" Tag="Recent" Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE81C;" FontSize="16" />
                            <TextBlock x:Name="NavTextRecent" Text="Recent" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemFavorites" AutomationProperties.Name="Favorites" Tag="Favorites" Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE734;" FontSize="16" />
                            <TextBlock x:Name="NavTextFavorites" Text="Favorites" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemCollections" AutomationProperties.Name="Collections" Tag="Collections" Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                            <TextBlock x:Name="NavTextCollections" Text="Collections" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemPresets" AutomationProperties.Name="Status Presets" Tag="Presets" Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE73E;" FontSize="16" />
                            <TextBlock x:Name="NavTextPresets" Text="Status Presets" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemFolders" AutomationProperties.Name="Customized Folders" Tag="Folders" Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                            <TextBlock x:Name="NavTextFolders" Text="Customized Folders" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemSettings" AutomationProperties.Name="Settings" Tag="Settings" Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock x:Name="NavTextSettings" Text="Settings" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Border>

            <!-- Main Content Area: Inset 32,8,32,28 for Title Bar integration -->
            <Grid x:Name="MainContentGrid" Grid.Column="1" Padding="32,8,32,28" RowDefinitions="Auto,*">
                <!-- Section Header (Fixed, not clipped) -->
                <Grid Grid.Row="0" Margin="0,0,0,20" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Name="SectionTitleText" Text="Library" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="SectionSubtitleText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Actions and Search affordances -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button
                            x:Name="ImportIconButton"
                            Content="Import Icon..."
                            AutomationProperties.Name="Import Icon"
                            ToolTipService.ToolTip="Import icon or image (Ctrl+O)"
                            Visibility="Visible"
                            Click="OnImportIconClicked" />
                        <TextBox
                            x:Name="SearchTextBox"
                            Width="220"
                            PlaceholderText="Search library..."
                            AutomationProperties.Name="Search library"
                            ToolTipService.ToolTip="Search library (Ctrl+F)"
                            Visibility="Collapsed"
                            TextChanged="OnSearchTextChanged" />
                        <Button
                            x:Name="ClearRecentButton"
                            Content="Clear Recent"
                            AutomationProperties.Name="Clear Recent"
                            Visibility="Collapsed"
                            Click="OnClearRecentClicked" />
                    </StackPanel>
                </Grid>

                <!-- Content Canvas -->
                <Grid Grid.Row="1">
                <!-- 1. LIBRARY VIEW -->
                <Grid x:Name="LibraryView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tag Filter Bar: Clean horizontal pill selector -->
                    <ScrollViewer Grid.Row="0" x:Name="TagFilterScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel x:Name="TagFilterBar" Orientation="Horizontal" Spacing="6" />
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" x:Name="LibraryEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE8B7;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="LibraryEmptyTitle" Text="No icons in library" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="LibraryEmptySubtitle" Text="Icons you customize will appear here" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" MaxWidth="380" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="LibraryEmptyGuidance"
                            Text="To customize a folder: right-click it in File Explorer and choose Set Folder Icon."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            MaxWidth="380"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="EmptyLibraryChooseFolderButton"
                            Content="Choose a folder..."
                            AutomationProperties.Name="Choose a folder to customize"
                            Margin="0,4,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnEmptyStateChooseFolderClicked" />
                    </StackPanel>

                    <!-- Icon Grid: Clean modern gallery tiles -->
                    <GridView
                        Grid.Row="1"
                        x:Name="LibraryGridView"
                        SelectionMode="None"
                        IsItemClickEnabled="True">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:LibraryItemVm">
                                <Grid Width="96" Height="104" Margin="6" Padding="6" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind ContextToggleFavoriteText}" Tag="{x:Bind Sha256}" Click="OnToggleFavoriteClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="{x:Bind FavoriteGlyph}" Foreground="{x:Bind FavoriteBrush}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ContextApplyToFolderText}" Tag="{x:Bind Sha256}" Click="OnApplyToFolderClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ContextOpenExplorerText}" Tag="{x:Bind CanonicalIcoPath}" Click="OnOpenIcoInExplorerClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8DA;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ContextManageTagsText}" Tag="{x:Bind Sha256}" Click="OnManageTagsClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8EC;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ContextManageCollectionsText}" Tag="{x:Bind Sha256}" Click="OnManageCollectionsClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8F1;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ContextExportIcoText}" Tag="{x:Bind CanonicalIcoPath}" Click="OnExportIcoClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEDE1;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSubItem Text="{x:Bind ContextExportPngText}" Tag="{x:Bind CanonicalIcoPath}">
                                                <MenuFlyoutSubItem.Icon>
                                                    <FontIcon Glyph="&#xEB9F;" />
                                                </MenuFlyoutSubItem.Icon>
                                                <MenuFlyoutItem Text="{x:Bind ExportPng1024Text}" Tag="1024" Click="OnExportPngClicked" />
                                                <MenuFlyoutItem Text="{x:Bind ExportPng512Text}" Tag="512" Click="OnExportPngClicked" />
                                                <MenuFlyoutItem Text="{x:Bind ExportPng256Text}" Tag="256" Click="OnExportPngClicked" />
                                            </MenuFlyoutSubItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Image Source="{x:Bind PreviewImage}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- Favorite toggle -->
                                    <Button
                                        Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        CornerRadius="14"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Tag="{x:Bind Sha256}"
                                        Click="OnToggleFavoriteClicked"
                                        ToolTipService.ToolTip="{x:Bind FavoriteToolTip}"
                                        AutomationProperties.Name="{x:Bind FavoriteToolTip}">
                                        <FontIcon Glyph="{x:Bind FavoriteGlyph}" FontSize="13" Foreground="{x:Bind FavoriteBrush}" />
                                    </Button>
                                    <!-- Format pill -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind SourceFormat}"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <!-- 2. RECENT VIEW -->
                <Grid x:Name="RecentView" Visibility="Collapsed">
                    <StackPanel x:Name="RecentEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE81C;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RecentEmptyTitle" Text="No recent icons" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RecentEmptySubtitle" Text="Icons you use will show up here." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" MaxWidth="360" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <GridView
                        x:Name="RecentGridView"
                        SelectionMode="None"
                        IsItemClickEnabled="True">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:RecentItemVm">
                                <Grid Width="96" Height="104" Margin="6" Padding="6" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Image Source="{x:Bind PreviewImage}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind TimeAgo}"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <!-- 3. FAVORITES VIEW -->
                <Grid x:Name="FavoritesView" Visibility="Collapsed">
                    <StackPanel x:Name="FavoritesEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE734;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="FavoritesEmptyTitle" Text="No favorite icons" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="FavoritesEmptySubtitle" Text="Click the star on any icon in the Library to add it to favorites." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" MaxWidth="360" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <GridView
                        x:Name="FavoritesGridView"
                        SelectionMode="None"
                        IsItemClickEnabled="True">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:LibraryItemVm">
                                <Grid Width="96" Height="104" Margin="6" Padding="6" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind ContextToggleFavoriteText}" Tag="{x:Bind Sha256}" Click="OnToggleFavoriteClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="{x:Bind FavoriteGlyph}" Foreground="{x:Bind FavoriteBrush}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ContextApplyToFolderText}" Tag="{x:Bind Sha256}" Click="OnApplyToFolderClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ContextOpenExplorerText}" Tag="{x:Bind CanonicalIcoPath}" Click="OnOpenIcoInExplorerClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8DA;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ContextManageTagsText}" Tag="{x:Bind Sha256}" Click="OnManageTagsClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8EC;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ContextManageCollectionsText}" Tag="{x:Bind Sha256}" Click="OnManageCollectionsClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8F1;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ContextExportIcoText}" Tag="{x:Bind CanonicalIcoPath}" Click="OnExportIcoClicked">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEDE1;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSubItem Text="{x:Bind ContextExportPngText}" Tag="{x:Bind CanonicalIcoPath}">
                                                <MenuFlyoutSubItem.Icon>
                                                    <FontIcon Glyph="&#xEB9F;" />
                                                </MenuFlyoutSubItem.Icon>
                                                <MenuFlyoutItem Text="{x:Bind ExportPng1024Text}" Tag="1024" Click="OnExportPngClicked" />
                                                <MenuFlyoutItem Text="{x:Bind ExportPng512Text}" Tag="512" Click="OnExportPngClicked" />
                                                <MenuFlyoutItem Text="{x:Bind ExportPng256Text}" Tag="256" Click="OnExportPngClicked" />
                                            </MenuFlyoutSubItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Image Source="{x:Bind PreviewImage}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- Favorite toggle -->
                                    <Button
                                        Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        CornerRadius="14"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Tag="{x:Bind Sha256}"
                                        Click="OnToggleFavoriteClicked"
                                        ToolTipService.ToolTip="{x:Bind FavoriteToolTip}"
                                        AutomationProperties.Name="{x:Bind FavoriteToolTip}">
                                        <FontIcon Glyph="{x:Bind FavoriteGlyph}" FontSize="13" Foreground="{x:Bind FavoriteBrush}" />
                                    </Button>
                                    <!-- Format pill -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind SourceFormat}"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <!-- 4. CUSTOMIZED FOLDERS VIEW (F20 Target Tray + Folders) -->
                <Grid x:Name="FoldersView"
                      Visibility="Collapsed"
                      AllowDrop="True"
                      DragOver="OnFoldersViewDragOver"
                      Drop="OnFoldersViewDrop">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Target Tray / Drag-and-Drop Area -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Staged Items Tray (visible when items staged) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Active / Customized Folders -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Drop Target Banner / Drop Zone -->
                    <Border Grid.Row="0"
                            x:Name="TargetTrayDropZone"
                            AutomationProperties.Name="Folder Staging Tray, click or press Enter to add folders"
                            ToolTipService.ToolTip="Add folders to customize (Enter, Space, Ctrl+V)"
                            Margin="0,0,0,16"
                            Padding="16,14"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            IsTabStop="True"
                            UseSystemFocusVisuals="True"
                            Tapped="OnTargetTrayDropZoneTapped"
                            KeyDown="OnTargetTrayDropZoneKeyDown">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <FontIcon Grid.Column="0" Glyph="&#xE838;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="TargetTrayTitle" Text="Folder Staging Tray" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="TargetTraySubtitle" Text="Drag and drop folders here to inspect or prepare them without modifying disk." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <!-- Limit / Status Warning -->
                            <TextBlock Grid.Column="2" x:Name="TargetTrayLimitNotice" Text="" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Staged Folders Tray Panel -->
                    <Border Grid.Row="1"
                            x:Name="TargetTrayStagedPanel"
                            Margin="0,0,0,16"
                            Padding="16,12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <!-- Staging Header & Actions -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock x:Name="StagedCountText" Text="Staged Folders (0)" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <!-- Progress Ring for in-flight validation -->
                                    <ProgressRing x:Name="StagingProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                                    <!-- Rejection summary pill -->
                                    <Button x:Name="ToggleRejectionsButton"
                                            Padding="8,2"
                                            CornerRadius="4"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderThickness="0"
                                            Click="OnToggleRejectionsClicked"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="RejectionSummaryText" Text="0 items rejected" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ClearStagingButton"
                                            Content="Clear Staging"
                                            Padding="10,4"
                                            FontSize="12"
                                            Click="OnClearStagingClicked"
                                            AutomationProperties.Name="Clear staged folders"
                                            ToolTipService.ToolTip="Clear staged folders (Ctrl+Z / Esc)" />
                                </StackPanel>
                            </Grid>

                            <!-- Virtualized list of accepted staged folders -->
                            <ListView x:Name="StagedFoldersListView"
                                      MaxHeight="200"
                                      SelectionMode="None"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:StagedFolderItemVm">
                                        <Grid Margin="0,2" Padding="6,6" ColumnSpacing="10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind FolderName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind FolderPath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Visibility="{x:Bind ExistingBadgeVisibility}">
                                                    <TextBlock Text="{x:Bind ExistingBadgeText}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Visibility="{x:Bind PortabilityVisibility}">
                                                    <TextBlock Text="{x:Bind PortabilityText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Expandable Rejections Panel -->
                            <StackPanel x:Name="RejectionsListPanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="RejectedItemsLabel" Text="Rejected Items:" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <ListView x:Name="RejectedFoldersListView"
                                          MaxHeight="120"
                                          SelectionMode="None"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:RejectedFolderItemVm">
                                            <Grid Margin="0,1" Padding="4,4" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind FolderPath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Reason}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: Existing Customized Folders List & Empty Panel -->
                    <Grid Grid.Row="2">
                        <StackPanel x:Name="FoldersEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE838;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="FoldersEmptyTitle" Text="No customized folders" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="FoldersEmptySubtitle" Text="Folders you customize will be listed here." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" MaxWidth="360" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Flat list of folders with separators per Visual Reference Spec -->
                        <ListView
                            x:Name="FoldersListView"
                            SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FolderItemVm">
                                <Grid Margin="0,4,0,4" Padding="8,10,8,10" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Folder Icon Preview -->
                                    <Image Grid.Column="0" Source="{x:Bind IconPreview}" Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Left" />

                                    <!-- Folder Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="8,0,16,0">
                                        <TextBlock Text="{x:Bind FolderName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FolderPath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind PortabilityLabel}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind PortabilityVisibility}" />
                                    </StackPanel>

                                    <!-- Health Status Indicator -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <FontIcon Glyph="{x:Bind HealthGlyph}" FontSize="14" Foreground="{x:Bind HealthBrush}" />
                                        <TextBlock Text="{x:Bind HealthLabel}" FontSize="12" Foreground="{x:Bind HealthBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Actions: Repair / Keep / Open -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button
                                            Content="{x:Bind RepairText}"
                                            Visibility="{x:Bind RepairButtonVisibility}"
                                            Tag="{x:Bind FolderPath}"
                                            Click="OnRepairFolderClicked"
                                            FontSize="12"
                                            Padding="10,4,10,4"
                                            AutomationProperties.Name="{x:Bind RepairAutomationName}" />
                                        <Button
                                            Content="{x:Bind KeepExternalText}"
                                            Visibility="{x:Bind KeepExternalButtonVisibility}"
                                            Tag="{x:Bind FolderPath}"
                                            Click="OnKeepExternalClicked"
                                            FontSize="12"
                                            Padding="10,4,10,4"
                                            AutomationProperties.Name="{x:Bind KeepExternalAutomationName}" />
                                        <Button
                                            Content="{x:Bind ReapplyText}"
                                            Visibility="{x:Bind KeepExternalButtonVisibility}"
                                            Tag="{x:Bind FolderPath}"
                                            Click="OnReapplyFolderClicked"
                                            FontSize="12"
                                            Padding="10,4,10,4"
                                            AutomationProperties.Name="{x:Bind ReapplyAutomationName}" />
                                        <Button
                                            Tag="{x:Bind FolderPath}"
                                            Click="OnOpenFolderInExplorerClicked"
                                            Padding="6"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            AutomationProperties.Name="{x:Bind OpenFolderAutomationName}"
                                            ToolTipService.ToolTip="{x:Bind OpenFolderAutomationName}">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- COLLECTIONS VIEW (F16) -->
                <Grid x:Name="CollectionsView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Collection List -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="CollectionsListHeader" Text="Collections" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="NewCollectionButton" Padding="8,4" HorizontalAlignment="Right" Click="OnNewCollectionClicked" AutomationProperties.Name="New Collection">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                                    <TextBlock x:Name="NewCollectionButtonText" Text="New" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Empty state when no collections -->
                        <StackPanel Grid.Row="1" x:Name="CollectionsEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE8F1;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CollectionsEmptyTitle" Text="No collections yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CollectionsEmptySubtitle" Text="Create one to organize icons" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>

                        <ListView
                            Grid.Row="1"
                            x:Name="CollectionsListView"
                            SelectionMode="Single"
                            SelectionChanged="OnCollectionsListViewSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:CollectionItemVm">
                                    <Grid Margin="0,2" Padding="6,8" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind AssetCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Button Width="26" Height="26" Padding="0" Tag="{x:Bind Id}" Click="OnMoveCollectionUpClicked" ToolTipService.ToolTip="{x:Bind MoveUpText}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind MoveUpText}">
                                                <FontIcon Glyph="&#xE74A;" FontSize="10" />
                                            </Button>
                                            <Button Width="26" Height="26" Padding="0" Tag="{x:Bind Id}" Click="OnMoveCollectionDownClicked" ToolTipService.ToolTip="{x:Bind MoveDownText}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind MoveDownText}">
                                                <FontIcon Glyph="&#xE74B;" FontSize="10" />
                                            </Button>
                                            <Button Width="26" Height="26" Padding="0" Tag="{x:Bind Id}" Click="OnRenameCollectionClicked" ToolTipService.ToolTip="{x:Bind RenameText}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind RenameText}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="10" />
                                            </Button>
                                            <Button Width="26" Height="26" Padding="0" Tag="{x:Bind Id}" Click="OnDeleteCollectionClicked" ToolTipService.ToolTip="{x:Bind DeleteText}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind DeleteText}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Divider -->
                    <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="8,0" />

                    <!-- Right: Selected Collection Assets Grid -->
                    <Grid Grid.Column="2" RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Margin="12,0,0,12" Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="SelectedCollectionTitle" Text="" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SelectedCollectionCount" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Empty collection content state -->
                        <StackPanel Grid.Row="1" x:Name="CollectionAssetsEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE8F1;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CollectionAssetsEmptyTitle" Text="Collection is empty" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CollectionAssetsEmptySubtitle" Text="Right-click any library icon to add it here" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <GridView
                            Grid.Row="1"
                            x:Name="CollectionAssetsGridView"
                            SelectionMode="None"
                            IsItemClickEnabled="True">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:LibraryItemVm">
                                    <Grid Width="96" Height="104" Margin="6" Padding="6" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="{x:Bind ContextToggleFavoriteText}" Tag="{x:Bind Sha256}" Click="OnToggleFavoriteClicked">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="{x:Bind FavoriteGlyph}" Foreground="{x:Bind FavoriteBrush}" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind ContextOpenExplorerText}" Tag="{x:Bind CanonicalIcoPath}" Click="OnOpenIcoInExplorerClicked">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8DA;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind RemoveFromCollectionText}" Tag="{x:Bind Sha256}" Click="OnRemoveFromCurrentCollectionClicked">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind ContextExportIcoText}" Tag="{x:Bind CanonicalIcoPath}" Click="OnExportIcoClicked">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xEDE1;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image Source="{x:Bind PreviewImage}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind SourceFormat}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Grid>

                <!-- 5. STATUS PRESETS VIEW (F04) -->
                <Grid x:Name="PresetsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top style template selector -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,16" VerticalAlignment="Center">
                        <TextBlock x:Name="PresetTemplateLabel" Text="Style Template:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton x:Name="PresetRadioClassic" Content="Classic" Tag="ornare-classic" GroupName="PresetTemplateGroup" IsChecked="True" Checked="OnPresetTemplateRadioChecked" />
                            <RadioButton x:Name="PresetRadioSoft" Content="Soft" Tag="ornare-soft" GroupName="PresetTemplateGroup" Checked="OnPresetTemplateRadioChecked" />
                            <RadioButton x:Name="PresetRadioFlat" Content="Flat" Tag="ornare-flat" GroupName="PresetTemplateGroup" Checked="OnPresetTemplateRadioChecked" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Presets Grid -->
                    <GridView
                        Grid.Row="1"
                        x:Name="PresetsGridView"
                        SelectionMode="None"
                        IsItemClickEnabled="False">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:PresetItemVm">
                                <Grid Width="220" Margin="0,0,16,16" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Preview Image -->
                                    <Border
                                        Grid.Row="0"
                                        Width="80"
                                        Height="80"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,12">
                                        <Image Source="{x:Bind PreviewImage}" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Preset Name -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind Title}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,4" />

                                    <!-- Description -->
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="{x:Bind Description}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        MinHeight="32"
                                        Margin="0,0,0,12" />

                                    <!-- Apply Button -->
                                    <Button
                                        Grid.Row="3"
                                        Content="{x:Bind ApplyButtonText}"
                                        Tag="{x:Bind PresetId}"
                                        Click="OnApplyPresetClicked"
                                        HorizontalAlignment="Stretch"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Disclaimer text (F05) -->
                    <TextBlock
                        Grid.Row="2"
                        x:Name="PresetDisclaimerText"
                        Text="Priority presets provide visual folder badges for organization and do not alter Windows filesystem priority or shell sorting."
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0" />
                </Grid>

                <!-- 6. SETTINGS VIEW -->
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,16,24,32">
                    <!-- Clean flat rows with dividers; no card-in-card per Visual Reference Spec -->
                    <StackPanel x:Name="SettingsContentPanel" Spacing="22" MaxWidth="760" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <!-- Appearance Section -->
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="SettingsAppearanceHeader" Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid Margin="0,4,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsThemeLabel" Text="App theme" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
                                <ComboBox
                                    x:Name="ThemeComboBox"
                                    Grid.Column="1"
                                    Width="180"
                                    HorizontalAlignment="Right"
                                    SelectionChanged="OnThemeSelectionChanged"
                                    AutomationProperties.Name="App theme">
                                    <ComboBoxItem x:Name="ThemeItemSystem" Content="System default" Tag="System" />
                                    <ComboBoxItem x:Name="ThemeItemLight" Content="Light" Tag="Light" />
                                    <ComboBoxItem x:Name="ThemeItemDark" Content="Dark" Tag="Dark" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,6,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Name="SettingsAccentLabel" Text="Accent color" FontSize="13" />
                                    <TextBlock
                                        x:Name="SettingsAccentHint"
                                        Text="Type a hex code such as #0F6CBD or pick a swatch."
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="AccentColorButton"
                                    Grid.Column="1"
                                    MinWidth="180"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Accent color">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            x:Name="AccentSwatch"
                                            Width="14"
                                            Height="14"
                                            CornerRadius="7"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock x:Name="AccentValueText" Text="#0F6CBD" FontSize="12" FontFamily="Consolas" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Width="288" Spacing="12">
                                                <ColorPicker
                                                    x:Name="AccentColorPicker"
                                                    IsAlphaEnabled="False"
                                                    IsColorChannelTextInputVisible="True"
                                                    IsHexInputVisible="True"
                                                    IsColorSliderVisible="True"
                                                    IsColorSpectrumVisible="True"
                                                    ColorChanged="OnAccentColorPickerChanged" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        x:Name="AccentHexBox"
                                                        PlaceholderText="#0F6CBD"
                                                        MaxLength="7"
                                                        FontFamily="Consolas"
                                                        TextChanged="OnAccentHexBoxTextChanged"
                                                        AutomationProperties.Name="Accent color hex" />
                                                    <Button x:Name="AccentApplyButton" Grid.Column="1" Click="OnAccentApplyClicked" Content="Apply" />
                                                </Grid>
                                                <Button
                                                    x:Name="AccentSystemButton"
                                                    HorizontalAlignment="Left"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Click="OnAccentSystemClicked"
                                                    Content="Use system accent" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <Grid Margin="0,6,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Name="SettingsAppIconLabel" Text="App icon" FontSize="13" />
                                    <TextBlock
                                        x:Name="SettingsAppIconSubtext"
                                        Text="Used by the window, taskbar and shortcuts."
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="AppIconComboBox"
                                    Grid.Column="1"
                                    Width="180"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    SelectionChanged="OnAppIconSelectionChanged"
                                    AutomationProperties.Name="App icon" />
                            </Grid>

                            <Grid Margin="0,6,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Name="SettingsScaleLabel" Text="Interface scale" FontSize="13" />
                                    <TextBlock
                                        x:Name="SettingsScaleSubtext"
                                        Text="Scales the whole interface. 100% is the default."
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="UiScaleComboBox"
                                    Grid.Column="1"
                                    MinWidth="120"
                                    VerticalAlignment="Center"
                                    SelectionChanged="OnUiScaleSelectionChanged"
                                    AutomationProperties.Name="Interface scale" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button x:Name="UiScaleResetButton" Click="OnUiScaleResetClicked" FontSize="12" Padding="8,4" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Language Section -->
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="SettingsLanguageHeader" Text="Language" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid Margin="0,4,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsLanguageLabel" Text="App language" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
                                <ComboBox
                                    x:Name="LanguageComboBox"
                                    Grid.Column="1"
                                    Width="180"
                                    HorizontalAlignment="Right"
                                    SelectionChanged="OnLanguageSelectionChanged"
                                    AutomationProperties.Name="App language">
                                    <ComboBoxItem x:Name="LangItemSystem" Content="System default" Tag="System" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Cloud backup Section -->
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="SettingsCloudHeader"
                                    Text="Cloud backup"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,4"
                                    VerticalAlignment="Center" />
                                <Border
                                    x:Name="CloudStatusBadge"
                                    Grid.Column="1"
                                    CornerRadius="9"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <TextBlock x:Name="CloudStatusText" FontSize="11" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,4,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="SettingsCloudProviderLabel"
                                    Text="Provider"
                                    FontSize="13"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="CloudProviderComboBox"
                                    Grid.Column="1"
                                    Width="180"
                                    HorizontalAlignment="Right"
                                    SelectionChanged="OnCloudProviderChanged"
                                    AutomationProperties.Name="Cloud provider">
                                    <ComboBoxItem x:Name="CloudProviderNoneItem" Content="Off" Tag="None" />
                                    <ComboBoxItem x:Name="CloudProviderOneDriveItem" Content="OneDrive" Tag="OneDrive" />
                                    <ComboBoxItem x:Name="CloudProviderGoogleItem" Content="Google Drive" Tag="GoogleDrive" />
                                    <ComboBoxItem x:Name="CloudProviderDropboxItem" Content="Dropbox" Tag="Dropbox" />
                                    <ComboBoxItem x:Name="CloudProviderCustomItem" Content="Folder" Tag="Custom" />
                                </ComboBox>
                            </Grid>

                            <TextBlock
                                x:Name="CloudSummaryText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <CommandBar
                                x:Name="CloudCommandBar"
                                HorizontalAlignment="Left"
                                DefaultLabelPosition="Right"
                                Background="Transparent"
                                Padding="0"
                                IsOpen="False">
                                <AppBarButton x:Name="CloudConnectButton" Icon="Link" Click="OnCloudConnectClicked" />
                                <AppBarButton x:Name="CloudSyncNowButton" Icon="Save" Click="OnCloudSyncNowClicked" />
                                <AppBarButton x:Name="CloudRestoreButton" Icon="Sync" Click="OnCloudRestoreClicked" />
                                <AppBarButton x:Name="CloudOpenFolderButton" Icon="OpenFile" Click="OnCloudOpenFolderClicked" />
                                <AppBarButton x:Name="CloudDisconnectButton" Icon="DisconnectDrive" Click="OnCloudDisconnectClicked" />
                            </CommandBar>

                            <ToggleSwitch
                                x:Name="CloudAutoSyncToggle"
                                Margin="0,4,0,0"
                                Toggled="OnCloudAutoSyncToggled"
                                AutomationProperties.Name="Back up changes automatically" />

                            <TextBlock
                                x:Name="CloudResultText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Diagnostics Section -->
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="SettingsDiagnosticsHeader" Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid x:Name="DiagnosticsRowGrid" Margin="0,4,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Name="SettingsDiagnosticsLabel" Text="Diagnostic Report" FontSize="13" />
                                    <TextBlock
                                        x:Name="SettingsDiagnosticsSubtext"
                                        Text="Exports system and health status with personal paths anonymized."
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="ExportReportButton"
                                    Grid.Column="1"
                                    Content="Export Diagnostic Report"
                                    Click="OnExportDiagnosticReportClicked"
                                    AutomationProperties.Name="Export Diagnostic Report"
                                    FontSize="12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- About Section -->
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="SettingsAboutHeader" Text="About" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid Margin="0,2,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsPublisherLabel" Text="Developer" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="Vellium" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,2,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsWebsiteLabel" Text="Website" FontSize="13" />
                                <HyperlinkButton x:Name="WebsiteHyperlink" Grid.Column="1" Content="vellium.dev" Padding="0" FontSize="13" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,2,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsVersionLabel" Text="Version" FontSize="13" />
                                <TextBlock x:Name="SettingsVersionValue" Grid.Column="1" Text="1.0.0" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,2,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsArchLabel" Text="Architecture" FontSize="13" />
                                <TextBlock x:Name="SettingsArchValue" Grid.Column="1" Text="x64" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock
                                x:Name="SettingsPrivacyStatement"
                                Text="Ornare works completely offline. Zero telemetry, zero cloud tracking, zero data collection."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Margin="0,8,0,0"
                                TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsRepositoryLabel" Text="Source code" FontSize="13" />
                                <HyperlinkButton x:Name="RepositoryHyperlink" Grid.Column="1" Padding="0" FontSize="13" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,2,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsSponsorLabel" Text="Support Ornare" FontSize="13" />
                                <HyperlinkButton x:Name="SponsorHyperlink" Grid.Column="1" Padding="0" FontSize="13" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,2,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsLicenseLabel" Text="License" FontSize="13" />
                                <HyperlinkButton x:Name="LicenseHyperlink" Grid.Column="1" Padding="0" FontSize="13" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,10,0,0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsOnboardingLabel" Text="Welcome tour" FontSize="13" VerticalAlignment="Center" />
                                <Button
                                    x:Name="ShowWelcomeButton"
                                    Grid.Column="1"
                                    Click="OnShowWelcomeClicked"
                                    FontSize="12"
                                    Padding="10,4"
                                    HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
        </Grid>
</Grid>
</Window>
