<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ornare.App.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Ornare">

    <Grid x:Name="ZoomViewport" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="ZoomSurface" RowDefinitions="48,*,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Drag region and step counter -->
            <Grid x:Name="TitleDragArea" Grid.Row="0" Background="Transparent" Padding="28,0,28,0">
                <TextBlock
                    x:Name="BrandLabel"
                    Text="Ornare"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="StepCounterText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>

            <!-- Step content -->
            <Grid Grid.Row="1" Padding="28,8,28,0">
                <!-- Step 1 fills the available height so the 73-entry picker scrolls in place -->
                <Grid x:Name="LanguageStepPanel" MaxWidth="560" HorizontalAlignment="Left" RowDefinitions="Auto,Auto,*" RowSpacing="14">
                    <TextBlock x:Name="LanguageHeading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="LanguageSubheading"
                        Grid.Row="1"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ListView
                        x:Name="LanguageList"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnLanguageSelectionChanged"
                        AutomationProperties.Name="Language" />
                </Grid>

                <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="560" HorizontalAlignment="Left">

                        <!-- Step 2: theme and accent -->
                        <StackPanel x:Name="ThemeStepPanel" Spacing="14" Visibility="Collapsed">
                            <TextBlock x:Name="ThemeHeading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ThemeSubheading"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock x:Name="ThemeModeLabel" FontSize="13" FontWeight="SemiBold" />
                                <StackPanel x:Name="ThemeModePanel" Orientation="Horizontal" Spacing="8">
                                    <RadioButton x:Name="ThemeSystemRadio" GroupName="OnboardingTheme" Tag="System" Checked="OnThemeModeChecked" />
                                    <RadioButton x:Name="ThemeLightRadio" GroupName="OnboardingTheme" Tag="Light" Checked="OnThemeModeChecked" />
                                    <RadioButton x:Name="ThemeDarkRadio" GroupName="OnboardingTheme" Tag="Dark" Checked="OnThemeModeChecked" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8" Margin="0,4,0,0">
                                <TextBlock x:Name="AccentLabel" FontSize="13" FontWeight="SemiBold" />
                                <StackPanel x:Name="AccentSwatchPanel" Orientation="Horizontal" Spacing="6" />
                                <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="AccentHexBox"
                                        PlaceholderText="#0F6CBD"
                                        FontFamily="Consolas"
                                        MaxLength="7"
                                        AutomationProperties.Name="Accent color hex" />
                                    <Button x:Name="AccentApplyButton" Grid.Column="1" Click="OnAccentApplyClicked" />
                                </Grid>
                                <TextBlock
                                    x:Name="AccentHint"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="8" Margin="0,4,0,0">
                                <TextBlock x:Name="ScaleLabel" FontSize="13" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="ScaleComboBox"
                                        MinWidth="140"
                                        SelectionChanged="OnScaleSelectionChanged"
                                        AutomationProperties.Name="Interface scale" />
                                    <TextBlock
                                        x:Name="ScaleValueText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 3: welcome -->
                        <StackPanel x:Name="WelcomeStepPanel" Spacing="14" Visibility="Collapsed">
                            <Image x:Name="WelcomeMark" Width="72" Height="72" HorizontalAlignment="Left" />
                            <TextBlock x:Name="WelcomeHeading" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="WelcomeBody"
                                FontSize="13"
                                LineHeight="22"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <StackPanel Spacing="8" Margin="0,6,0,0">
                                <TextBlock x:Name="WelcomePointOne" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="WelcomePointTwo" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="WelcomePointThree" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 4: tour and cloud -->
                        <StackPanel x:Name="TourStepPanel" Spacing="14" Visibility="Collapsed">
                            <TextBlock x:Name="TourHeading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="TourSubheading"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <StackPanel Spacing="6" Margin="0,6,0,0">
                                <TextBlock x:Name="TourPointOne" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="TourPointTwo" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="TourPointThree" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="TourPointFour" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="CloudToggle"
                                Margin="0,10,0,0"
                                Toggled="OnCloudToggleToggled"
                                AutomationProperties.Name="Cloud backup" />
                            <TextBlock
                                x:Name="CloudDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="CloudPathText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Padding="28,16,28,24" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SkipButton" Click="OnSkipClicked" Background="Transparent" BorderThickness="0" Padding="8,6" />
                <Button x:Name="BackButton" Grid.Column="2" Click="OnBackClicked" MinWidth="96" />
                <Button
                    x:Name="NextButton"
                    Grid.Column="3"
                    Click="OnNextClicked"
                    MinWidth="120"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
